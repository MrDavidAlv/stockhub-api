# Copiar este archivo a `.env` (mismo directorio que el pom.xml).
# `.env` esta en .gitignore y NO se sube al repo.
# Tanto Spring Boot (via spring.config.import) como Docker Compose lo leen.

# ---- Base de datos ----
POSTGRES_DB=stockhub_db
POSTGRES_USER=stockhub
POSTGRES_PASSWORD=cambia-esto-en-tu-local

# ---- JWT (debe ser >=32 caracteres para HS384) ----
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-32-chars-o-mas

# ---- Seed de usuarios (creados al primer arranque) ----
SEED_ADMIN_PASSWORD=cambia-esto-por-una-password-segura
SEED_EXTERNO_PASSWORD=cambia-esto-por-otra-password-segura

# ---- Email (Mailpit por defecto en dev) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
MAIL_FROM=no-reply@stockhub.local

# ---- CORS ----
CORS_ORIGINS=http://localhost:9000
